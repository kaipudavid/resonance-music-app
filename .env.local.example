# Demo mode - set to false when configured with real music generation provider
NEXT_PUBLIC_DEMO_MODE=true

# Music Generation Provider (demo, suno, elevenlabs, etc.)
NEXT_PUBLIC_PROVIDER=demo

# Server-side provider credentials (NEVER expose in browser)
# MUSIC_PROVIDER_API_KEY=your_key_here
# MUSIC_PROVIDER_BASE_URL=https://api.provider.com

# Database
# DATABASE_URL=postgresql://user:password@localhost:5432/resonance

# NextAuth
# NEXTAUTH_SECRET=your-secret-key-here
# NEXTAUTH_URL=http://localhost:3000

# File Upload
MAX_UPLOAD_SIZE_MB=100
MAX_AUDIO_DURATION_SECONDS=600
