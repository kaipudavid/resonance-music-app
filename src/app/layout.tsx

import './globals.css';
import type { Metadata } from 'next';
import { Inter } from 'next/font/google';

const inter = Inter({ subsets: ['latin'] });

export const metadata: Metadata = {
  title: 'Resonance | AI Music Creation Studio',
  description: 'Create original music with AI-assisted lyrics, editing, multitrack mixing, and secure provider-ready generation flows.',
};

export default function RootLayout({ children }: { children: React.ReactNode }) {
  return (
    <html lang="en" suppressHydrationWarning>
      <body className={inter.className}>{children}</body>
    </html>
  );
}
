@tailwind base;
@tailwind components;
@tailwind utilities;

:root {
  color-scheme: dark;
  --bg: #070b1c;
  --bg-soft: #10192d;
  --panel: rgba(17, 24, 39, 0.92);
  --panel-border: rgba(148, 163, 184, 0.14);
  --text: #edf2ff;
  --muted: #a7b4d7;
  --brand: #9d5eff;
  --brand-2: #6ee7f9;
  --accent: #f9a8d4;
  --success: #a7f3d0;
  --warning: #fbbf24;
}

html {
  scroll-behavior: smooth;
}

body {
  background:
    radial-gradient(circle at top left, rgba(157, 94, 255, 0.18), transparent 25%),
    radial-gradient(circle at bottom right, rgba(110, 231, 249, 0.12), transparent 22%),
    var(--bg);
  color: var(--text);
  min-height: 100vh;
  font-family: Arial, Helvetica, sans-serif;
}

* {
  box-sizing: border-box;
}

::selection {
  background: rgba(157, 94, 255, 0.35);
}

@layer components {
  .panel {
    @apply rounded-2xl border border-white/10 bg-slate-900/80 shadow-studio backdrop-blur-sm;
  }

  .panel-soft {
    @apply rounded-2xl border border-white/10 bg-slate-950/60;
  }

  .button-primary {
    @apply inline-flex items-center justify-center rounded-xl bg-gradient-to-r from-violet-500 to-fuchsia-400 px-4 py-2.5 text-sm font-semibold text-white shadow-lg shadow-violet-500/20 transition hover:brightness-110 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-violet-300;
  }

  .button-secondary {
    @apply inline-flex items-center justify-center rounded-xl border border-white/10 bg-slate-800/80 px-4 py-2.5 text-sm font-medium text-slate-100 transition hover:border-violet-400/60 hover:bg-slate-700/70 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-violet-300;
  }

  .input {
    @apply w-full rounded-xl border border-white/10 bg-slate-900/70 px-3 py-2.5 text-sm text-slate-50 placeholder:text-slate-400 focus:border-violet-400 focus:outline-none focus:ring-2 focus:ring-violet-500/30;
  }

  .muted {
    @apply text-sm text-slate-300;
  }

  .title-hero {
    @apply text-4xl font-black tracking-tight text-white md:text-6xl;
  }

  .section-title {
    @apply text-2xl font-bold tracking-tight text-white md:text-3xl;
  }

  .gradient-text {
    @apply bg-gradient-to-r from-violet-300 via-fuchsia-300 to-cyan-300 bg-clip-text text-transparent;
  }
}

.light-theme body {
  background:
    radial-gradient(circle at top left, rgba(157, 94, 255, 0.16), transparent 20%),
    linear-gradient(180deg, #f7f7fb 0%, #eef2ff 100%);
  color: #111827;
}

.light-theme .panel,
.light-theme .panel-soft,
.light-theme .button-secondary,
.light-theme .input {
  background-color: rgba(255, 255, 255, 0.8);
  color: #111827;
  border-color: rgba(148, 163, 184, 0.35);
}

.light-theme .muted,
.light-theme .text-slate-300,
.light-theme .text-slate-400,
.light-theme .text-slate-500 {
  color: #465067 !important;
}

.light-theme .text-white,
.light-theme .text-slate-100 {
  color: #0f172a !important;
}

.wavebar {
  display: flex;
  align-items: end;
  gap: 3px;
  height: 46px;
}

.wavebar span {
  display: block;
  width: 4px;
  border-radius: 999px;
  background: linear-gradient(180deg, rgba(110,231,249,1), rgba(157,94,255,1));
  animation: wave 1.1s ease-in-out infinite;
}

.wavebar span:nth-child(odd) {
  animation-delay: 0.15s;
}

.wavebar span:nth-child(3n) {
  animation-delay: 0.3s;
}

@keyframes wave {
  0%, 100% { transform: scaleY(0.45); opacity: 0.7; }
  50% { transform: scaleY(1); opacity: 1; }
}

@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
    scroll-behavior: auto !important;
  }
}
